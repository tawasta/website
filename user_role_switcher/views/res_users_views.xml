<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_res_users_form_inherit_allowed_roles" model="ir.ui.view">
    <field name="name">res.users.form.inherit.allowed.roles.with.company</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base_user_role.view_res_users_form_inherit" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='role_line_ids']" position="after">
        <group string="Roles">
          <field name="allowed_role_line_ids" context="{'default_user_id': active_id}">
            <tree editable="bottom">
              <field name="role_id" />
              <field name="company_id" />
            </tree>
          </field>
          <field name="current_role_id" readonly="1" />
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_res_users_role_form_inherit_flags" model="ir.ui.view">
    <field name="name">res.users.role.form.inherit.flags</field>
    <field name="model">res.users.role</field>
    <field name="inherit_id" ref="base_user_role.view_res_users_role_form" />
    <field name="arch" type="xml">
      <field name="group_id" position="after">
        <field name="allow_in_allowed_roles" />
        <field name="locked_for_allowed_roles" />
      </field>
    </field>
  </record>
</odoo>
