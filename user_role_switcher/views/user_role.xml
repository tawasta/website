<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_role_switch_link" inherit_id="portal.user_dropdown">
        <xpath expr="//*[@id='o_logout_divider']" position="before">
            <button
                t-if="request.env.user.allowed_role_line_ids and len(request.env.user.allowed_role_line_ids) &gt; 1"
                class="dropdown-item text-primary fw-bold"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#modal_user_role"
                title="Change your active role"
            >
                <i class="fa fa-user me-1" /> Change Role
            </button>
        </xpath>

        <xpath expr="//li" position="after">
            <div
                id="modal_user_role"
                class="modal fade"
                tabindex="-1"
                role="dialog"
                aria-labelledby="User Role Modal"
                aria-hidden="true"
            >
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title">Select Active Role</h4>
                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"
                            />
                        </div>
                        <form
                            id="user_role_form"
                            action="/portal/switch_role"
                            method="post"
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                t-att-value="request.csrf_token()"
                            />
                            <div class="modal-body">
                                <div
                                    class="alert alert-info mb-3"
                                    role="alert"
                                    t-if="request.env.user.current_role_id"
                                >
                                    <strong>Current role:</strong>
                                    <span
                                        t-esc="request.env.user.current_role_id.name"
                                    />
                                </div>
                                <div class="form-group">
                                    <label for="role_id">Select Role</label>
                                    <select
                                        id="role_id"
                                        name="role_id"
                                        class="form-select"
                                    >
                                        <t
                                            t-foreach="request.env.user.allowed_role_line_ids.mapped('role_id')"
                                            t-as="role"
                                        >
                                            <option
                                                t-att-value="role.id"
                                                t-att-selected="role.id == (request.env.user.current_role_id.id or 0)"
                                            >
                                                <t t-esc="role.name" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button
                                    type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal"
                                >Cancel</button>
                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
