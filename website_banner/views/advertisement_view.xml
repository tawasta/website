<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Lomake bannerille -->
    <record id="view_form_advertisement" model="ir.ui.view">
        <field name="name">advertisement.form</field>
        <field name="model">advertisement.advertisement</field>
        <field name="arch" type="xml">
            <form string="Advertisement">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="advertisement_category_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="url"/>
                        <field name="is_active"/>
                        <field name="image" widget="image"/>
                        <field name="view_count" />
                        <field name="click_count" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Listanäkymä -->
    <record id="view_tree_advertisement" model="ir.ui.view">
        <field name="name">advertisement.tree</field>
        <field name="model">advertisement.advertisement</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="advertisement_category_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_active"/>
                <field name="view_count"/>
                <field name="click_count"/>
            </tree>
        </field>
    </record>

    <!-- Toiminto -->
    <record id="action_advertisement" model="ir.actions.act_window">
        <field name="name">Advertisements</field>
        <field name="res_model">advertisement.advertisement</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_advertisement_root" name="Advertisements" parent="website.menu_website_configuration"/>
    <menuitem id="menu_advertisement_entries" name="Manage Ads" parent="menu_advertisement_root" action="action_advertisement"/>
</odoo>
