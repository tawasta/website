<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="banner_snippets" inherit_id="website.snippets" name="Wide Banner Snippet Integration">
        <xpath expr="//div[@id='snippet_structure']" position="inside">
            <div class="o_panel">
                <div class="o_panel_header">Wide Banner</div>
                <div class="o_panel_body">
                    <t t-snippet="website_banner.banner_snippet_template" string="Banner Snippet" t-thumbnail="/website/static/src/img/s_banner_snippet.svg">
                        <keywords>banner, advertisement, wide, full-width</keywords>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
