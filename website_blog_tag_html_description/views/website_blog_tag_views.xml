<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="blog_tag_form_inherit" model="ir.ui.view">
        <field name="name">blog.tag.form.inherit.tag.html.description</field>
        <field name="model">blog.tag</field>
        <field name="inherit_id" ref="website_blog.blog_tag_form" />
        <field name="arch" type="xml">
            <field name="post_ids" position="after">
                <group string="Tag HTML Description">
                    <field name="html_description" />
                </group>
            </field>
        </field>
    </record>
</odoo>
