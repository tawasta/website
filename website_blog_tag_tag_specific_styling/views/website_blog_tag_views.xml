<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="blog_tag_form" model="ir.ui.view">
        <field name="name">blog.tag.form.inherit.css.styles</field>
        <field name="model">blog.tag</field>
        <field name="inherit_id" ref="website_blog.blog_tag_form" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="css_classes" />
            </field>
        </field>
    </record>

    <record id="blog_tag_tree" model="ir.ui.view">
        <field name="name">blog.tag.tree.inherit.css.styles</field>
        <field name="model">blog.tag</field>
        <field name="inherit_id" ref="website_blog.blog_tag_tree" />
        <field name="arch" type="xml">
            <field name="post_ids" position="after">
                <field name="css_classes" optional="show" />
            </field>
        </field>
    </record>

</odoo>
