<odoo>
    <!-- Backend filter record -->
    <record id="dynamic_snippet_tagcloud_filter" model="ir.filters">
        <field name="name">Mainokset (aktiiviset)</field>
        <field name="model_id">blog.tag</field>
        <field name="user_id" eval="False" />
        <field name="domain">[]</field>
        <field name="sort">[]</field>
        <field name="action_id" ref="website.action_website" />
    </record>

    <!-- Website dynamic filter (this connects templates + fields + filter) -->
    <record id="dynamic_filter_tagcloud" model="website.snippet.filter">
        <field name="name">Mainosfilteri</field>
        <field
            name="filter_id"
            ref="website_blog_tag_widget.dynamic_snippet_tagcloud_filter"
        />
        <field name="field_names">name</field>
        <field name="limit" eval="1" />
    </record>
</odoo>
