<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="blog_post_view_form_add_domain_all" model="ir.ui.view">
        <field name="name">blog.post.view.form.add.domain.all</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.blog_post_view_form_add"/>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='blog_id']" position="attributes">
                <attribute name="domain">
                    ['|', ('website_id','=',False),
                        ('website_id','=', context.get('website_id'))]
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="blog_post_view_form_add_domain_manager" model="ir.ui.view">
        <field name="name">blog.post.view.form.add.domain.manager</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.blog_post_view_form_add"/>
        <field name="priority" eval="999"/>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='blog_id']" position="attributes"
                groups="website_manager_group.group_website_manager">
                <attribute name="domain">[]</attribute>
            </xpath>
        </field>
    </record>

</odoo>