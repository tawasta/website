<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <!-- Hide Sign in button -->
  <template
    id="login"
    inherit_id="web.login"
    name="Hide native login"
    active="True"
    customize_show="True"
  >
    <!-- The user switch needs the hidden login fields and hides the form
         holding the OAuth buttons, so it is shown only with the native login -->
    <xpath expr="//owl-component[@name='web.user_switch']" position="attributes">
      <attribute name="t-if">debug and not login</attribute>
    </xpath>
    <xpath expr="//form[@t-attf-action='/web/login']" position="attributes">
      <attribute
        name="t-attf-class"
      >oe_login_form #{'' if login or not debug else 'd-none'}</attribute>
    </xpath>
    <xpath expr="//label[@for='login']/.." position="attributes">
      <attribute name="t-if">debug</attribute>
    </xpath>
    <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="attributes">
      <attribute name="t-if">debug</attribute>
    </xpath>
    <xpath expr="//button[hasclass('btn', 'btn-primary')]" position="attributes">
      <attribute name="t-if">debug</attribute>
    </xpath>
  </template>

  <template
    id="providers"
    inherit_id="web.login_oauth"
    name="Hide 'or' from oauth'"
    active="True"
    customize_show="True"
  >
    <xpath expr="//em" position="attributes">
      <attribute name="t-if">debug</attribute>
    </xpath>
  </template>

  <template
    id="passkey_login"
    inherit_id="auth_passkey.auth_passkey_login_oauth"
    name="Hide 'Use a Passkey'"
    active="True"
    customize_show="True"
  >
    <xpath expr="//t[@t-value='auth_btns + passkey_btn']" position="attributes">
      <attribute name="t-value">auth_btns + passkey_btn if debug else auth_btns</attribute>
    </xpath>
  </template>

  <template
    id="signup_login"
    inherit_id="auth_signup.login"
    name="Hide 'reset password'"
    active="True"
    customize_show="True"
  >
    <xpath expr="//a[@t-if='reset_password_enabled']" position="attributes">
      <attribute name="class">d-none</attribute>
    </xpath>
  </template>

  <template
    id="signup_account"
    inherit_id="auth_signup.login"
    name="Hide 'Don't have an account?'"
    active="True"
    customize_show="True"
  >
    <xpath expr="//a[@t-if='signup_enabled']" position="attributes">
      <attribute name="class">d-none</attribute>
    </xpath>
  </template>
</odoo>
