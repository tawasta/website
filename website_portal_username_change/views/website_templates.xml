<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="change_username_button" inherit_id="portal.portal_my_security">
        <xpath expr="//section[@name='portal_change_password']" position="after">

            <section name="portal_change_username">
                <h4>Change username</h4>
                <div class="alert alert-secondary">
                    <i class="fa fa-warning"></i>
                    This change does not affect your account's email address, where messages and notifications are sent. It only updates your login username.
                </div>
                <button type="button" class="btn btn-secondary" id="changeUsernameModal">
                            <i class="fa fa-user-edit"/> Change Username
                </button>
            </section>
    </template>

    <template id="change_username_modal" name="Change Username Modal">
        <div
            class="modal fade"
            id="changeUsernameModal"
            tabindex="-1"
            role="dialog"
            aria-labelledby="changeUsernameModalLabel"
            aria-hidden="true"
        >
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5
                            class="modal-title"
                            id="changeUsernameModalLabel"
                        >Change Username</h5>
                        <button
                            type="button"
                            class="btn-close text-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                        />
                    </div>
                    <div class="modal-body">
                        <form
                            action="/my/change_username"
                            id="change_username_form"
                            method="post"
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                t-att-value="request.csrf_token()"
                            />

                            <!-- Current Username -->
                            <div class="mb-3">
                                <label
                                    for="current_login"
                                    class="form-label fw-bold"
                                >Current Username</label>
                                <input
                                    type="text"
                                    class="form-control"
                                    id="current_login"
                                    name="current_login"
                                    t-att-value="current_login"
                                    disabled="disabled"
                                />
                            </div>

                            <!-- New Username -->
                            <div class="mb-3">
                                <label
                                    for="new_login"
                                    class="form-label fw-bold"
                                >New Username</label>
                                <input
                                    type="email"
                                    class="form-control"
                                    id="new_login"
                                    name="new_login"
                                    required="1"
                                    placeholder="Enter new username"
                                />
                            </div>

                            <!-- Confirm New Username -->
                            <div class="mb-3">
                                <label
                                    for="confirm_login"
                                    class="form-label fw-bold"
                                >Confirm New Username</label>
                                <input
                                    type="email"
                                    class="form-control"
                                    id="confirm_login"
                                    name="confirm_login"
                                    required="1"
                                    placeholder="Re-enter new username"
                                />
                            </div>

                            <div class="text-end">
                                <button
                                    type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal"
                                >Cancel</button>
                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </template>


</odoo>
