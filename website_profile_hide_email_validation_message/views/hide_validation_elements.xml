<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="hide_email_banner_courses_home"
        inherit_id="website_slides.courses_home"
    >
        <xpath
            expr="//div[hasclass('o_wprofile_email_validation_container')]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template
        id="hide_email_banner_courses_all"
        inherit_id="website_slides.courses_all"
    >
        <xpath
            expr="//div[hasclass('o_wprofile_email_validation_container')]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template
        id="hide_email_banner_profile_content"
        inherit_id="website_profile.user_profile_content"
    >
        <xpath
            expr="//div[hasclass('o_wprofile_email_validation_container')]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template
        id="hide_not_verified_text"
        inherit_id="website_profile.user_profile_header"
    >
        <xpath expr="//h1[hasclass('o_card_people_name')]/small" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
