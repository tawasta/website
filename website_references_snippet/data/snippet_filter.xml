<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_filter_references" model="ir.filters">
        <field name="name">References</field>
        <field name="model_id">res.references</field>
        <field name="user_id" eval="False" />
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{}</field>
        <field name="sort">['featured desc','sequence asc','id asc']</field>
    </record>

    <record id="dynamic_filter_references" model="website.snippet.filter">
        <field name="name">References</field>
        <field name="filter_id" ref="website_references_snippet.ir_filter_references" />
        <field
            name="field_names"
        >name,description,image,link,button_link,category_ids</field>
        <field name="limit" eval="16" />
    </record>
</odoo>
