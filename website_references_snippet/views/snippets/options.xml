<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="s_references_options"
        inherit_id="website.snippet_options"
        name="References Options"
    >
        <xpath expr="." position="inside">
            <div data-selector=".s_references_snippet" data-js="references_snippet">

                <we-select
                    string="Filter"
                    data-name="filter_opt"
                    data-attribute-name="filterId"
                    data-no-preview="true"
                />

                <we-select
                    string="Template"
                    data-name="template_opt"
                    data-attribute-name="templateKey"
                    data-no-preview="true"
                />

                <we-select string="Records" data-attribute-name="numberOfRecords">
                    <we-button data-select-data-attribute="3">3</we-button>
                    <we-button data-select-data-attribute="6">6</we-button>
                    <we-button data-select-data-attribute="9">9</we-button>
                    <we-button data-select-data-attribute="12">12</we-button>
                    <we-button data-select-data-attribute="15">15</we-button>
                    <we-button data-select-data-attribute="18">18</we-button>
                    <we-button data-select-data-attribute="21">21</we-button>
                    <we-button data-select-data-attribute="24">24</we-button>
                    <we-button data-select-data-attribute="27">27</we-button>
                    <we-button data-select-data-attribute="30">30</we-button>
                    <we-button data-select-data-attribute="33">33</we-button>
                    <we-button data-select-data-attribute="36">36</we-button>
                    <we-button data-select-data-attribute="39">39</we-button>
                    <we-button data-select-data-attribute="42">42</we-button>
                    <we-button data-select-data-attribute="45">45</we-button>
                    <we-button data-select-data-attribute="48">48</we-button>
                    <we-button data-select-data-attribute="51">51</we-button>
                    <we-button data-select-data-attribute="54">54</we-button>
                    <we-button data-select-data-attribute="57">57</we-button>
                    <we-button data-select-data-attribute="60">60</we-button>
                    <we-button data-select-data-attribute="63">63</we-button>
                    <we-button data-select-data-attribute="66">66</we-button>
                    <we-button data-select-data-attribute="69">69</we-button>
                    <we-button data-select-data-attribute="70">70</we-button>
                </we-select>

                <we-many2many
                    string="Categories"
                    data-name="reference_category_opt"
                    data-attribute-name="referenceCategoryIds"
                    data-no-preview="true"
                    data-model="res.references.category"
                    data-allow-delete="true"
                    data-fakem2m="true"
                    data-select-data-attribute=""
                />

            </div>
        </xpath>
    </template>
</odoo>
