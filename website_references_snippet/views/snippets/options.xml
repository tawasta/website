<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="s_references_options" inherit_id="website.snippet_options" name="References Options">
        <xpath expr="." position="inside">
            <div data-selector=".s_references_snippet" data-js="references_snippet">

                <we-select
                    string="Filter"
                    data-name="filter_opt"
                    data-attribute-name="filterId"
                    data-no-preview="true"/>

                <we-select
                    string="Template"
                    data-name="template_opt"
                    data-attribute-name="templateKey"
                    data-no-preview="true"/>

                <we-select string="Records" data-attribute-name="numberOfRecords">
                    <we-button data-select-data-attribute="3">3</we-button>
                    <we-button data-select-data-attribute="6">6</we-button>
                    <we-button data-select-data-attribute="9">9</we-button>
                    <we-button data-select-data-attribute="12">12</we-button>
                    <we-button data-select-data-attribute="16">16</we-button>
                </we-select>

                <we-select string="Category" data-attribute-name="filterByCategoryIds">
                    <we-button data-select-data-attribute="[]">All</we-button>
                    <t t-foreach="request.env['res.references.category'].sudo().search([('active', '=', True)], order='sequence, name')" t-as="category">
                        <we-button t-att-data-select-data-attribute="'[%s]' % category.id">
                            <t t-out="category.name"/>
                        </we-button>
                    </t>
                </we-select>

            </div>
        </xpath>
    </template>
</odoo>