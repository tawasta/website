<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="s_references" name="References">
        <section
            class="s_references_snippet s_references_hover py-5"
            data-snippet="s_references"
            data-name="References"
            data-filter-id="website_references_snippet.dynamic_filter_references"
            data-template-key="website_references_snippet.dynamic_filter_template_res_references_card"
            data-number-of-records="6"
            data-filter-by-category-ids="[]"
        >

            <div class="container">
                <div class="row justify-content-center text-center mb-5">
                    <div class="col-lg-8">
                        <span class="s_references_hover__eyebrow">
                            Customer references
                        </span>
                        <h2 class="display-5 fw-bold mb-3">
                            Our References
                        </h2>
                        <p class="lead text-muted mb-0">
                            Trusted customers, partners and success stories.
                        </p>
                    </div>
                </div>

                <div class="row g-4 dynamic_snippet_template" />
            </div>
        </section>
    </template>

    <template id="dynamic_filter_template_res_references_card" name="References Card">
        <t t-foreach="records" t-as="data">
            <t t-set="record" t-value="data['_record']" />

            <div class="col-12">
                <article class="s_reference_card h-100">
                    <div class="s_reference_card__logo_wrap">
                        <a
                            t-if="record.link"
                            t-att-href="record.link"
                            class="s_reference_card__logo_link"
                        >

                            <img
                                t-if="data.get('image')"
                                t-att-src="data['image']"
                                t-att-alt="record.name"
                                class="s_reference_card__logo"
                            />

                            <div
                                t-if="not data.get('image')"
                                class="s_reference_card__placeholder"
                            >
                                <i class="fa fa-building" aria-hidden="true" />
                            </div>
                        </a>

                        <div t-if="not record.link" class="s_reference_card__logo_link">

                            <img
                                t-if="data.get('image')"
                                t-att-src="data['image']"
                                t-att-alt="record.name"
                                class="s_reference_card__logo"
                            />

                            <div
                                t-if="not data.get('image')"
                                class="s_reference_card__placeholder"
                            >
                                <i class="fa fa-building" aria-hidden="true" />
                            </div>
                        </div>
                    </div>

                    <div class="s_reference_card__body">
                        <p
                            t-if="record.description"
                            class="s_reference_card__description"
                            t-field="record.description"
                        />

                        <a
                            t-if="record.button_link"
                            t-att-href="record.button_link"
                            class="s_reference_card__link"
                        >
                            Read customer story
                            <i class="fa fa-arrow-right" aria-hidden="true" />
                        </a>
                    </div>
                </article>
            </div>
        </t>
    </template>
</odoo>
