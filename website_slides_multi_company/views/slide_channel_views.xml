<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_slide_channel_form" model="ir.ui.view">
        <field name="name">slide.channel.view.form.multi.company</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form" />
        <field name="arch" type="xml">
            <field name="website_id" position="after">
                <field
                    name="company_id"
                    options="{'no_create': True}"
                    groups="base.group_multi_company"
                />
            </field>
        </field>
    </record>

    <record id="slide_channel_view_tree" model="ir.ui.view">
        <field name="name">slide.channel.view.tree.multi.company</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.slide_channel_view_tree" />
        <field name="arch" type="xml">
            <field name="website_id" position="after">
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </field>
        </field>
    </record>
</odoo>
